{
  "name": "healthlens-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && rm -rf frontend/dist && cp -r dist frontend/dist",
    "start": "node server.ts",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  }
}
