{
  "name": "healthlens-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && rm -rf frontend/dist && cp -r dist frontend/dist && cp dist/index.html dist/404.html && cp dist/index.html frontend/dist/404.html && touch dist/.nojekyll && touch frontend/dist/.nojekyll",
    "start": "node server.ts",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1"
  }
}
